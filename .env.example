# FreshGuard AI Environment Configuration

# Application Mode & Security
APP_NAME=FreshGuard AI
APP_ENV=development
SECRET_KEY=freshguard_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# Database Configuration
# Uses SQLite locally by default if PostgreSQL is not active
DATABASE_URL=sqlite:///./freshguard.db
# For PostgreSQL: postgresql://freshguard:freshguard_pass@localhost:5432/freshguard_db

# External APIs (Optional / Modular)
OPEN_FOOD_FACTS_API_URL=https://world.openfoodfacts.org/api/v2/product
FIREBASE_SERVER_KEY=mock_firebase_key_for_notifications

# Server Port
PORT=8000
HOST=0.0.0.0
